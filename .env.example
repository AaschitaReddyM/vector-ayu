# VAYU — Supabase credentials
# Copy this file to ".env" and fill in the values from your Supabase dashboard.
#   Project URL + anon key:    Settings -> Data API / API Keys
#   service_role key (secret): Settings -> API Keys  (bypasses RLS — server only)
#
# Do NOT commit the real .env file. It is git-ignored.

SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key
